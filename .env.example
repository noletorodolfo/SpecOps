# Which adapter to use: mock (default, no credentials needed), huggingface, openai, or ollama
SPECOPS_MODEL=mock

# Hugging Face (SPECOPS_MODEL=huggingface)
HF_TOKEN=
SPECOPS_HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# OpenAI (SPECOPS_MODEL=openai)
OPENAI_API_KEY=
SPECOPS_OPENAI_MODEL=gpt-4o-mini

# Ollama (SPECOPS_MODEL=ollama) — local server, no API key needed
OLLAMA_HOST=http://localhost:11434
SPECOPS_OLLAMA_MODEL=llama3.1
